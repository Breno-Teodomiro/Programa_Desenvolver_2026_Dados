# Ambiente virtual
.venv/

# Python cache
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Arquivos temporários gerados pelo pipeline
/tmp/

# Outputs intermediários gerados (regeneráveis pelo pipeline)
outputs/bronze/
outputs/silver/
# Gold: ignora apenas os artefatos PESADOS e regeneráveis (parquets de feature
# matrix + Random Forest de 82 MB). O modelo de produção (lgbm_dontgo.pkl),
# calibradores e todos os JSONs de resultado SÃO versionados e acompanham a
# entrega, para que relatório, app.py e generate_report.py rodem sem o pipeline.
outputs/gold/*.parquet
outputs/gold/random_forest.pkl

# Logs de execução dos sprints (artefatos de build, regeneráveis)
outputs/*.log

# Sistema operacional
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/
*.swp

# Claude Code settings
.claude/

# Material pessoal de apoio (não faz parte do entregável)
GUIA_APRESENTACAO.md
